<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <route id="employee-flatfile-to-json">
        <from uri="file:input?noop=true"/>

        <log message="Reading file: ${header.CamelFileName}"/>

        <process ref="flatFileToEmployeeProcessor"/>

        <split>
            <simple>${body}</simple>

            <marshal>
                <json library="Jackson"/>
            </marshal>

            <log message="Employee JSON:\n${body}"/>
        </split>
    </route>

</routes>
