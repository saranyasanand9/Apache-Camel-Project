<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <route id="flatfile-995-800-route">
        <onException>
            <exception>org.apache.kafka.common.errors.SerializationException</exception>
            <handled><constant>true</constant></handled>
            <log message="Kafka Serialization Error: ${exception.message}" loggingLevel="ERROR"/>
            <to uri="log:kafkaSerializationError"/>
        </onException>

        <onException>
            <exception>org.apache.kafka.common.KafkaException</exception>
            <handled><constant>true</constant></handled>
            <log message="Kafka General Error: ${exception.message}" loggingLevel="ERROR"/>
            <to uri="log:kafkaGeneralError"/>
        </onException>
        <onException>
            <exception>com.example.demo.models.RecordValidationException</exception>
            <handled><constant>true</constant></handled>

            <log message="VALIDATION ERROR: ${exception.message}" loggingLevel="ERROR"/>

            <setBody>
                <simple>
                    {
                    "error": "${exception.message}",
                    "fieldName": "${exception.fieldName}",
                    "recordId": "${exception.recordId}",
                    "rowNumber": "${exception.rowNumber}",
                    "originalMessage": "${exchangeProperty.originalRawLine}"
                    }
                </simple>
            </setBody>

            <to uri="kafka:flatfile-error?brokers=kafka-2541682b-saranyasanand9-bae4.g.aivencloud.com:20449"/>
        </onException>

         <onException>
             <exception>java.lang.Exception</exception>
             <handled><constant>true</constant></handled>
             <log message="SYSTEM ERROR: Unexpected error occurred: ${exception.stacktrace}" loggingLevel="ERROR"/>
             <setBody>
                 <simple>
                     {
                     "error": "${exception.message}",
                     "stacktrace": "${exception.stacktrace}",
                     "originalMessage": "${exchangeProperty.originalRawLine}"
                     }
                 </simple>
             </setBody>
             <to uri="kafka:flatfile-error?brokers=kafka-2541682b-saranyasanand9-bae4.g.aivencloud.com:20449"/>
         </onException>

        <from uri="file:input?noop=true"/>

        <log message="Processing file: ${header.CamelFileName}"/>

        <!-- Split file line by line -->
        <split>
            <tokenize token="\n"/>
            <setProperty name="originalRawLine">
                <simple>${body}</simple>
            </setProperty>
            <choice>
                <when>
                    <simple>${body} startsWith '995'</simple>
                    <unmarshal>
                        <bindy type="Fixed"
                               classType="com.example.demo.models.HeaderRecord"/>
                    </unmarshal>

                    <setProperty name="fileHeader">
                        <simple>${body}</simple>
                    </setProperty>

                    <log message="Header captured: ${exchangeProperty.fileHeader}"/>
                    <setBody>
                        <method beanType="com.example.demo.component.WrapperBuilder"
                                method="build"/>
                    </setBody>
                </when>

                <when>
                    <simple>${body} startsWith '800'</simple>
                    <unmarshal>
                        <bindy type="Fixed"
                               classType="com.example.demo.models.BodyRecord"/>
                    </unmarshal>
                    <bean beanType="com.example.demo.component.RecordValidator" method="validate"/>
                    <setProperty name="currentBody">
                        <simple>${body}</simple>
                    </setProperty>

                    <setBody>
                        <method beanType="com.example.demo.component.WrapperBuilder"
                                method="build"/>
                    </setBody>

                    <!-- Convert to proper JSON -->
                    <marshal>
                        <json library="Jackson"/>
                    </marshal>

                    <log message="Sending to kafka: ${body}"/>
                    <to uri="kafka:flatfile-topic?brokers=kafka-2541682b-saranyasanand9-bae4.g.aivencloud.com:20449"/>
                </when>

                <otherwise>
                    <log message="Ignoring record: ${body}"/>
                </otherwise>

            </choice>

        </split>

    </route>

</routes>
