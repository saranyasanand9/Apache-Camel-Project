<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <route id="flatfile-995-800-route">

        <onException>
            <exception>org.apache.camel.ValidationException</exception>
            <handled><constant>true</constant></handled>
            <log message="VALIDATION ERROR: ${exception.message} in file ${header.CamelFileName}" loggingLevel="ERROR"/>
            <to uri="file:error?fileName=${header.CamelFileName}.invalid"/>
        </onException>

        <onException>
            <exception>java.lang.Exception</exception>
            <handled><constant>true</constant></handled>
            <log message="SYSTEM ERROR: Unexpected error occurred: ${exception.stacktrace}" loggingLevel="ERROR"/>
            <to uri="file:error?fileName=${header.CamelFileName}.invalid"/>
        </onException>

        <from uri="file:input?noop=true"/>

        <log message="Processing file: ${header.CamelFileName}"/>

        <!-- Split file line by line -->
        <split>
            <tokenize token="\n"/>
            <choice>
                <when>
                    <simple>${body} startsWith '995'</simple>
                    <unmarshal>
                        <bindy type="Fixed"
                               classType="com.example.demo.models.HeaderRecord"/>
                    </unmarshal>
                    <bean beanType="com.example.demo.component.RecordValidator" method="validateHeader"/>
                    <setProperty name="fileHeader">
                        <simple>${body}</simple>
                    </setProperty>

                    <log message="Header captured: ${exchangeProperty.fileHeader}"/>
                    <setBody>
                        <method beanType="com.example.demo.component.WrapperBuilder"
                                method="build"/>
                    </setBody>
                </when>

                <when>
                    <simple>${body} startsWith '800'</simple>
                    <unmarshal>
                        <bindy type="Fixed"
                               classType="com.example.demo.models.BodyRecord"/>
                    </unmarshal>
                    <bean beanType="com.example.demo.component.RecordValidator" method="validate"/>
                    <setProperty name="currentBody">
                        <simple>${body}</simple>
                    </setProperty>

                    <setBody>
                        <method beanType="com.example.demo.component.WrapperBuilder"
                                method="build"/>
                    </setBody>

                    <!-- Convert to proper JSON -->
                    <marshal>
                        <json library="Jackson"/>
                    </marshal>

                    <log message="Sending to kafka: ${body}"/>
                    <to uri="kafka:flatfile-topic?brokers=kafka-2541682b-saranyasanand9-bae4.g.aivencloud.com:20449"/>
                </when>

                <otherwise>
                    <log message="Ignoring record: ${body}"/>
                </otherwise>

            </choice>

        </split>

    </route>

</routes>
