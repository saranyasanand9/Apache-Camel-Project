<?xml version="1.0" encoding="UTF-8"?>
<camelContext xmlns="http://camel.apache.org/schema/spring">
    <onException>
        <exception>java.lang.Exception</exception>
        <handled><constant>true</constant></handled>
        <log message="Error processing file: ${exception.message}" loggingLevel="ERROR"/>
    </onException>
    <route id="flatfile-995-800-route">

        <from uri="file:input?noop=true"/>

        <log message="Processing file: ${header.CamelFileName}"/>

        <!-- Split file line by line -->
        <split>
            <tokenize token="\n"/>
            <choice>
                <when>
                    <simple>${body} startsWith '995'</simple>
                    <unmarshal>
                        <bindy type="Fixed"
                               classType="com.example.demo.models.HeaderRecord"/>
                    </unmarshal>
                    <setProperty name="fileHeader">
                        <simple>${body}</simple>
                    </setProperty>

                    <log message="Header captured: ${exchangeProperty.fileHeader}"/>
                    <setBody>
                        <method beanType="com.example.demo.component.WrapperBuilder"
                                method="build"/>
                    </setBody>
                </when>

                <when>
                    <simple>${body} startsWith '800'</simple>
                    <unmarshal>
                        <bindy type="Fixed"
                               classType="com.example.demo.models.BodyRecord"/>
                    </unmarshal>
                    <setProperty name="currentBody">
                        <simple>${body}</simple>
                    </setProperty>

                    <setBody>
                        <method beanType="com.example.demo.component.WrapperBuilder"
                                method="build"/>
                    </setBody>

                    <!-- Convert to proper JSON -->
                    <marshal>
                        <json library="Jackson"/>
                    </marshal>

                    <log message="Sending to kafka: ${body}"/>
                    <to uri="kafka:flatfile-topic?brokers=kafka-2541682b-saranyasanand9-bae4.g.aivencloud.com:20449"/>
                </when>

                <otherwise>
                    <log message="Ignoring record: ${body}"/>
                </otherwise>

            </choice>

        </split>

    </route>

</camelContext>
