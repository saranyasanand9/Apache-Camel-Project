<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <route id="flat-file-to-json-route">
        <from uri="file:input?fileName=flatFile.dat&amp;noop=true"/>
        <log message="Reading file: ${header.CamelFileName}"/>

        <unmarshal>
            <bindy type="Fixed" classType="com.example.demo.models.HeaderRecord"/>
        </unmarshal>

        <bean ref="fileProcessor" method="prepareData"/>

        <split>
            <simple>${body}</simple>
            <process ref="jsonFormattingProcessor"/>
            <marshal>
                <json library="Jackson" prettyPrint="true"/>
            </marshal>
            <log message="\n--- Individual JSON Record ---\n${body}"/>
        </split>
    </route>
</routes>